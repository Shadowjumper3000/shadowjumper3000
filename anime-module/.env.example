# MyAnimeList Waybar module configuration

# MAL API base URL
MAL_API_BASE="https://api.myanimelist.net/v2"

# Public username (required when only MAL_CLIENT_ID is used)
# Use plain username (no @), for example: MAL_USERNAME="myname"
MAL_USERNAME=""

# OAuth token (required for private list access or when MAL_USERNAME is @me)
MAL_ACCESS_TOKEN=""

# MAL client id header (optional if MAL_ACCESS_TOKEN is set, required for public-list mode)
MAL_CLIENT_ID=""

# Cache settings
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/anime-module"
MAL_CACHE_TTL=900
CURL_TIMEOUT=15

# UI tuning
MAX_TITLE_LEN=28
