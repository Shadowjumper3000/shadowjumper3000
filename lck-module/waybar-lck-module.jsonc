// Waybar LCK Scores Module - Updated with Smart Display
// Shows live matches with series score or upcoming match timer
// - Shows teams + match wins when game is live
// - Shows countdown timer when upcoming match within 24h
// - Hidden by default when no relevant game (auto-hides)
// - Hover shows detailed season records and schedule
// - Right-click to select which game to display (if multiple live)
//
// Add this to your ~/.config/waybar/config.jsonc

{
  "custom/lck": {
    "format": "{}",
    "exec": "$HOME/dev/shadowjumper3000/lck-module/lck-scores.sh",
    "interval": 30,
    "return-type": "json",
    "on-click": "xdg-open 'https://watch.lolesports.com' &",
    "on-right-click": "$HOME/dev/shadowjumper3000/lck-module/lck-select-match.sh",
    "class": "lck-module"
  }
}
