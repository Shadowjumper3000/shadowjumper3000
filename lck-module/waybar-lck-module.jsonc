// Waybar LCK Scores Module with Kill Counts and Match Selection
// Add this to your ~/.config/waybar/config.jsonc

{
  "custom/lck": {
    "format": "{}",
    "exec": "$HOME/dev/shadowjumper3000/lck-module/lck-scores.sh",
    "interval": 30,
    "return-type": "plain",
    "on-click": "$HOME/dev/shadowjumper3000/lck-module/lck-scores.sh refresh && pkill -RTMIN+1 waybar && xdg-open 'https://andydanger.github.io/live-lol-esports/'",
    "on-right-click": "$HOME/dev/shadowjumper3000/lck-module/lck-select-match.sh",
    "tooltip": true,
    "tooltip-format": "{}",
    "class": "lck-module"
  }
  ,
  "custom/lck-live": {
    "format": "{}",
    "exec": "$HOME/dev/shadowjumper3000/lck-module/lck-live-feed.sh",
    "interval": 15,
    "return-type": "plain",
    "tooltip": true,
    "tooltip-format": "{}",
    "class": "lck-module lck-live"
  }
}
