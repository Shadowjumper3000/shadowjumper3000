# LCK Module Configuration
# Copy this file to .env and customize if needed

# API Endpoints
LCK_API_BASE="https://esports-api.lolesports.com/persisted/gw"
LCK_LIVE_ENDPOINT="${LCK_API_BASE}/getLive?hl=en-US"
LCK_SCHEDULE_ENDPOINT="${LCK_API_BASE}/getSchedule?hl=en-US"

# API Authentication (optional - API may have rate limits without key)
LCK_API_KEY="0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z"

# Cache Configuration
LCK_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lck-scores"
LCK_LIVE_CACHE_TTL=30
LCK_SCHEDULE_CACHE_TTL=60

# Display Configuration
LCK_SHOW_UPCOMING_HOURS=24
LCK_CURL_TIMEOUT=10
