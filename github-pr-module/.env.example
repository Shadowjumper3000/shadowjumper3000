# GitHub PR Waybar Module Configuration
# Copy this file to .env and customize values

# GitHub identity
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN=""

# API configuration
API_BASE="https://api.github.com"
INVOLVED_QUERY="is:pr is:open archived:false involves:${GITHUB_USERNAME}"
REVIEW_QUERY="is:pr is:open archived:false review-requested:${GITHUB_USERNAME}"
PER_PAGE=30

# Cache and fetch behavior
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/github-pr-tracker"
CACHE_TTL=60
CURL_TIMEOUT=10

# Display behavior
MAX_TITLE_LENGTH=70

# Notification behavior
ENABLE_NOTIFICATIONS=true
NOTIFY_NEW_PRS=true
NOTIFY_REVIEW_REQUESTS=true
NOTIFY_PR_UPDATES=false
NOTIFY_PR_REMOVED=true
NOTIFICATION_DEDUPE_TTL=21600
