# LoL Esports Module Configuration
# Copy this file to .env and customize if needed

# API Endpoints
API_BASE="https://esports-api.lolesports.com/persisted/gw"
LIVE_ENDPOINT="${API_BASE}/getLive?hl=en-US"
SCHEDULE_ENDPOINT="${API_BASE}/getSchedule?hl=en-US"

# API Authentication (optional - API may have rate limits without key)
API_KEY="0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z"

# Cache Configuration
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lol-scores"
LIVE_CACHE_TTL=30
SCHEDULE_CACHE_TTL=60

# Display Configuration
SHOW_UPCOMING_HOURS=24
CURL_TIMEOUT=10
